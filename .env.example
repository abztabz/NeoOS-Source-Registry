# Independent Neo Data Gateway runtime.
# JSON object mapping consumer ids to unique bearer tokens (minimum 24 chars each).
# Example only: {"neocontent":"replace-with-strong-secret","neocrm":"replace-with-another-secret"}
NEO_GATEWAY_CONSUMER_TOKENS=

# Experimental provider execution stays disabled in production unless deliberately enabled.
NEO_GATEWAY_ALLOW_EXPERIMENTAL=false

# Approved provider runtime identification / credentials.
# Use a descriptive contact-bearing User-Agent where provider policy requires it.
NEO_SEC_USER_AGENT=
NEO_MET_USER_AGENT=
NEO_COMPANIES_HOUSE_KEY=
NEO_DATA_GOV_KEY=

# Experimental providers remain fail-closed unless both runtime and request explicitly opt in.
NEO_SERPAPI_KEY=
NEO_ZENSERP_KEY=
